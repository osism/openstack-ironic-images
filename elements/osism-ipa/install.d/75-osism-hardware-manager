#!/bin/bash

if [ ${DIB_DEBUG_TRACE:-0} -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

# Runs after ironic-python-agent-ramdisk's 60-* has created IPA's
# virtualenv; the manager registers itself through its entry point.
VENVDIR=/opt/ironic-python-agent

# /tmp/in_target.d is mounted read-only, and setuptools builds in the
# source tree, so build from a writable copy.
SRCDIR=$(mktemp -d)
cp -r /tmp/in_target.d/osism-ipa-hardware/. $SRCDIR/
$VENVDIR/bin/pip install --no-deps --no-build-isolation $SRCDIR
rm -rf $SRCDIR
